generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Downturn {
  NEUTRAL
  MODERATE
  AGGRESSIVE
  UNKNOWN
}

enum Stiffness {
  SOFT
  MEDIUM
  STIFF
  UNKNOWN
}

enum Closure {
  LACE_UP
  HOOK_AND_LOOP
  SLIPPER
  UNKNOWN
}

enum FootWidth {
  NARROW
  REGULAR
  WIDE
  UNKNOWN
}

enum HeelVolume {
  LOW
  REGULAR
  HIGH
  UNKNOWN
}

enum ToeShape {
  BIG_TOE
  SECOND_TOE
  SQUARE
  UNKNOWN
}

enum ClimbingExperience {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  UNKNOWN
}

enum ClimbingDiscipline {
  BOULDERING
  SPORT
  TRAD
  MIXED
  UNKNOWN
}

enum FitPreference {
  COMFORT
  BALANCED
  PERFORMANCE
  UNKNOWN
}

enum OverallFit {
  TIGHT
  COMFORTABLE
  LOOSE
  UNKNOWN
}

model Shoe {
  id              String      @id @default(cuid())
  slug            String      @unique
  brand           String
  model           String
  description     String?
  sourceUrl       String?
  sourceCheckedAt DateTime?
  isSample        Boolean     @default(false)
  downturn        Downturn    @default(UNKNOWN)
  stiffness       Stiffness   @default(UNKNOWN)
  closure         Closure     @default(UNKNOWN)
  width           FootWidth   @default(UNKNOWN)
  heelVolume      HeelVolume  @default(UNKNOWN)
  fitRecords      FitRecord[]
  savedBy         SavedShoe[]
}

model User {
  id              String           @id
  name            String
  email           String           @unique
  emailVerified   Boolean          @default(false)
  image           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  sessions        Session[]
  accounts        Account[]
  climbingProfile ClimbingProfile?
  fitRecords      FitRecord[]
  savedShoes      SavedShoe[]

  @@map("user")
}

model FitRecord {
  photo       FitPhoto?
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  shoeId      String
  shoe        Shoe       @relation(fields: [shoeId], references: [id], onDelete: Restrict)
  sizeEu      Float
  fit         OverallFit @default(UNKNOWN)
  toeFit      OverallFit @default(UNKNOWN)
  forefootFit OverallFit @default(UNKNOWN)
  heelFit     OverallFit @default(UNKNOWN)
  rating      Int?
  notes       String     @default("")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId, createdAt])
  @@index([shoeId])
}

model FitPhoto {
  recordId    String    @id
  record      FitRecord @relation(fields: [recordId], references: [id], onDelete: Restrict)
  objectKey   String    @unique
  contentType String
  size        Int
  createdAt   DateTime  @default(now())
}

model ClimbingProfile {
  userId        String             @id
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  footLengthMm  Float?
  streetSizeEu  Float?
  width         FootWidth          @default(UNKNOWN)
  toeShape      ToeShape           @default(UNKNOWN)
  heelVolume    HeelVolume         @default(UNKNOWN)
  experience    ClimbingExperience @default(UNKNOWN)
  discipline    ClimbingDiscipline @default(UNKNOWN)
  fitPreference FitPreference      @default(UNKNOWN)
  updatedAt     DateTime           @updatedAt
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model SavedShoe {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shoeId    String
  shoe      Shoe     @relation(fields: [shoeId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@id([userId, shoeId])
  @@index([shoeId])
}
