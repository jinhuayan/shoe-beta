generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Shoe {
  id          String  @id @default(cuid())
  slug        String  @unique
  brand       String
  model       String
  description String?
  isSample    Boolean @default(false)
}
